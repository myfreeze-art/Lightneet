<?xml version="1.0" encoding="utf-8"?>
<!--
    Inflated from XML because `allowUndo` has no public setter. TextView's undo history keeps
    copies of earlier edits — i.e. fragments of the password — so it must be off.
-->
<EditText xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="LabelFor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:allowUndo="false"
    android:background="@null"
    android:importantForAutofill="noExcludeDescendants"
    android:inputType="textPassword|textNoSuggestions"
    android:imeOptions="actionDone|flagNoPersonalizedLearning|flagNoExtractUi"
    android:longClickable="false"
    android:singleLine="true"
    android:textIsSelectable="false"
    android:saveEnabled="false" />
