    <!-- Setup -->
    <string name="setup_tagline">Encrypted storage that tells nothing about itself.</string>
    <string name="setup_point_password_title">Only your password opens it</string>
    <string name="setup_point_password_body">No fingerprint, no cloud account. Every file, name and folder is encrypted with a key derived from your password.</string>
    <string name="setup_point_offline_title">Nothing leaves this phone</string>
    <string name="setup_point_offline_body">Lightneet has no internet permission at all. Its storage is bound to this phone\'s secure hardware — a copy taken elsewhere is useless.</string>
    <string name="setup_point_norecovery_title">There is no recovery</string>
    <string name="setup_point_norecovery_body">If you forget the password, your data is gone forever. This is not a bug — it is the protection.</string>
    <string name="setup_start">Create storage</string>
    <string name="setup_password_title">Choose a password</string>
    <string name="setup_password_body">A long phrase is both stronger and easier to remember than a short jumble of symbols.</string>
    <string name="setup_password_tip_title">Tip</string>
    <string name="setup_password_tip_body">Four or five random words, e.g. “lamp river cobalt orbit”, are very hard to guess.</string>
    <string name="hint_password">Password</string>
    <string name="hint_password_repeat">Repeat password</string>
    <string name="hint_new_password">New password</string>
    <string name="passwords_differ">Passwords do not match</string>
    <string name="password_too_weak">Too easy to guess — make it longer</string>
    <string name="strength_weak">Weak</string>
    <string name="strength_fair">Fair</string>
    <string name="strength_good">Good</string>
    <string name="strength_excellent">Excellent</string>
    <string name="setup_options_title">Storage</string>
    <string name="setup_options_body">Space is reserved up front and filled with random noise, so nobody can tell how much of it you use. It grows automatically when needed.</string>
    <string name="setup_initial_size">Initial size</string>
    <string name="setup_size_hint">Free on this phone: %1$s</string>
    <string name="setup_reserve">Reserve for a hidden vault</string>
    <string name="reserve_none">None</string>
    <string name="reserve_none_body">All space for one vault. A hidden vault cannot be added later.</string>
    <string name="reserve_quarter">25% (recommended)</string>
    <string name="reserve_quarter_body">Every 4th block is set aside. It looks exactly like used space.</string>
    <string name="reserve_half">50%</string>
    <string name="reserve_half_body">Room for a large hidden vault, at the cost of half the space.</string>
    <string name="setup_reserve_hint">The reserve exists whether or not you ever create a hidden vault, so it proves nothing.</string>
    <string name="setup_create">Create</string>
    <string name="setup_calibrating">Measuring this phone</string>
    <string name="setup_calibrating_body">Tuning the password hashing so that each guess costs an attacker about a second.</string>
    <string name="setup_allocating">Filling storage with noise</string>
    <string name="setup_allocating_body">Free and used space must be indistinguishable. This happens only once.</string>

